# 影像面板后端配置（复制成 .env.local 后填写；.env.local 已被 git 忽略）
# Supabase 控制台 → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 站主邮箱：只有这个邮箱登录后才有编辑权限（必须与 supabase/schema.sql 里 is_owner() 的邮箱一致）
VITE_OWNER_EMAIL=you@example.com

# 可选：点「B 站主页」按钮时跳转的地址
VITE_BILIBILI_PROFILE=https://space.bilibili.com/你的UID
